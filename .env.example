# TOP DESIGN - Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=3000

# Domain
DOMAIN=www.gobiznessrocket.co.in
# Comma-separated list of origins the browser is allowed to call /api/* from.
# Include every domain (with and without www) where the site is served.
# Omit trailing slashes. The server also allows requests with no Origin header
# (same-origin browser requests and Postman/curl).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,https://gobiznessrocket.com,https://www.gobiznessrocket.com,https://gobiznessrocket.co.in,https://www.gobiznessrocket.co.in

# Email Configuration (for contact form notifications)
# Gmail requires 2-Step Verification and a 16-character App Password. Do not
# use your normal Gmail password and never commit a real App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=shubhamlonkar137@gmail.com
SMTP_PASS=pbiaswhiebpdbabz
FROM_EMAIL=shubhamlonkar137@gmail.com
FROM_NAME=Gobizness Rocket
ADMIN_EMAIL=shubhamlonkar137@gmail.com
# EMAIL_FROM and SUPPORT_EMAIL are also accepted for backwards compatibility.

# Admin Panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$YourHashedPasswordHere
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database (for production - MongoDB/MySQL/PostgreSQL)
# DATABASE_URL=mongodb://localhost:27017/topdesign
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=topdesign
# DB_USER=root
# DB_PASS=password

# Cloud Storage (for images/assets)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=topdesign-assets
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Analytics
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# FACEBOOK_PIXEL_ID=XXXXXXXXXX

# reCAPTCHA (for form spam protection)
# RECAPTCHA_SITE_KEY=your-site-key
# RECAPTCHA_SECRET_KEY=your-secret-key
