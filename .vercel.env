# Vercel Environment Variables
# Add these in Vercel Dashboard → Project Settings → Environment Variables

# Application
NODE_ENV=production
DOMAIN=www.topdesign.co.in

# Email (for contact form)
# Set these in Vercel Dashboard; this file is only a safe checklist and is not
# loaded automatically by Vercel. Gmail requires an App Password, not the
# account password. Never put a real password in this file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=shubhamlonkar137@gmail.com
SMTP_PASS=pbiaswhiebpdbabz
FROM_EMAIL=shubhamlonkar137@gmail.com
FROM_NAME=Gobizness Rocket
ADMIN_EMAIL=shubhamlonkar137@gmail.com
